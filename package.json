{
  "name": "rocruzta-hub",
  "productName": "Rocruzta Hub",
  "version": "0.1.5",
  "description": "Centro de navegação dos apps da Rocruzta",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "empacotar": "electron-builder --win nsis",
    "empacotar:pasta": "electron-builder --win dir"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0"
  },
  "author": "Rocruzta",
  "build": {
    "appId": "com.rocruzta.hub",
    "productName": "Rocruzta Hub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icone.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rocruzta Hub",
      "artifactName": "Rocruzta-Hub-Setup-${version}.${ext}"
    }
  }
}
